# ─── DỮ LIỆU HỌC SINH — TUYỆT ĐỐI KHÔNG ĐƯA LÊN REPO ───────────────────────
# data_final.csv chứa ngày sinh, trường và tỉnh của từng thí sinh. Giấy xác
# nhận sử dụng dữ liệu của Viện Đào tạo số và Khảo thí (ĐHQGHN) cấm chuyển
# giao cho bên thứ ba khi chưa có văn bản cho phép của Viện trưởng, và yêu cầu
# loại bỏ các trường bán định danh này. Không gỡ dòng dưới đây.
data/
*.csv
*.xlsx

# ─── Tài liệu tham khảo có bản quyền ───────────────────────────────────────
thamkhao/

# ─── Hồ sơ nộp: có chữ ký, con dấu và thông tin liên hệ ─────────────────────
submission/

# ─── Ghi chú nội bộ (chiến lược phản biện, nhật ký quyết định) ──────────────
notes/

# ─── Bản thảo bài báo (phát hành qua nhà xuất bản, không qua repo) ──────────
paper/*.docx
paper/*.md
# Mốc phiên bản đã gửi/nhận — cùng lý do; được Nextcloud sao lưu, không cần git.
paper/versions/

# ─── Rác build ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/
node_modules/

# ─── Cấu hình Claude Code cục bộ (symlink tới máy cá nhân) ──────────────────
.claude/

# Log chạy thô (có đường dẫn máy cá nhân)
results/*.out

# ─── Script đồng bộ server (chứa IP nội bộ, tài khoản) ─────────────────────
*.local.*

# ─── Dữ liệu giả cho kiểm thử và dự đoán từng bản ghi ──────────────────────
# fixtures do tests/make_fake_data.py, make_fake_preds.py sinh lại được; preds/
# chứa chỉ số dòng và y của dữ liệu thật trên server, không đưa lên repo.
tests/fixtures/
preds/

# ─── Dữ liệu công khai cho E11 (tải lại được, kiểm bằng SHA256SUMS) ─────────
data_public/

# Thư mục tạm của joblib khi chạy trên server
.joblib_tmp/
